# Salin ke direktori deploy di VPS sebagai .env (JANGAN di-commit ke Git).
# --- dipakai docker compose ---
APP_IMAGE=ghcr.io/PEMILIK/NAMA-REPO-app:latest
WEB_IMAGE=ghcr.io/PEMILIK/NAMA-REPO-web:latest
DOMAIN=absensi.wijayaplywoods.com

# --- dipakai Laravel ---
APP_NAME="Absensi Marketing"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://absensi.wijayaplywoods.com

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=absensi_marketing
DB_USERNAME=absensi
DB_PASSWORD=GANTI_PASSWORD_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
